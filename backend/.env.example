# GitHub personal access token (classic, scope: read:user is enough).
# Required for the GraphQL contribution calendar and higher rate limits.
GITHUB_TOKEN=

# Default GitHub username to show when the app opens
DEFAULT_GITHUB_USER=

# LLM provider for the chatbot features: gemini | groq | openai | none
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=

# Cache time-to-live in seconds (default 1 hour)
CACHE_TTL_SECONDS=3600

# SQLite file location
DB_PATH=portfolio_cache.db
